__pycache__/
*.py[cod]

# Published reference scores kept in the repo root (100MB+ facsimiles, not
# project code). Globbed around the accented characters on purpose: the files
# on disk carry NFD-decomposed names (e + U+0300) while a literal rule typed
# here is NFC (U+00E8), so a literal match silently never fires.
La vivandi*re Pas de six*.pdf
Soir*e musicale.pdf

# Third-party reference publications (~56MB of ICKL proceedings). Fetch with
# `python references/fetch_ickl.py`; see references/ickl/README.md.
references/ickl/*.pdf

# Transient render scratch dirs
tests/.tmp/
dancenotation-pdf-*/

# Generated score output. Renders accumulate every time generate_score runs;
# only the checked-in sample-* fixtures and .gitkeep files are tracked.
examples/svg/*.svg
examples/pdf/*.pdf
examples/pdf/*.png
examples/tex/
!examples/svg/sample-render.svg
!examples/pdf/sample-render.pdf
!examples/svg/.gitkeep
!examples/pdf/.gitkeep

# Local Claude Code session settings
.claude/settings.local.json
